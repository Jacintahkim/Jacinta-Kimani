  .nav-logo{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:1.1rem;}
  .nav-logo span{color:var(--teal);}
  .nav-links{display:flex;gap:32px;font-family:'JetBrains Mono',monospace;font-size:0.85rem;}
  .nav-links a{color:var(--text-muted);position:relative;transition:color .2s;}
  .nav-links a:hover{color:var(--teal);}
  .nav-links a::before{content:"";}
  .nav-toggle{display:none;background:none;border:none;color:var(--text);font-size:1.4rem;cursor:pointer;}

  /* -------- HERO -------- */
